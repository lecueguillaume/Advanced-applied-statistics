# Ignore all PDF files
*.pdf
!materials/**/*.pdf

# Ignore Quarto execution cache and hidden internal state
/.quarto/
*_cache/
**/*.quarto_ipynb
_site/

# knitr TikZ intermediates (never commit; keep tikz-template.tex)
tikz[0-9a-f]*
*_files/figure-*/**/*.dvi

# Ignore the synchronize .sh
sync.sh

# OS metadata
.DS_Store

# Python / Jupyter notebooks
.ipynb_checkpoints/
__pycache__/
*.pyc